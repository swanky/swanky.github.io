{
  "title": "重力休息的那一天",
  "title_en": "The Day Gravity Rested",
  "series": "神話未完成",
  "series_en": "Myths in the Making",
  "volume": 35,
  "model": "史旺姬",
  "creator": "史旺基 Swanky",
