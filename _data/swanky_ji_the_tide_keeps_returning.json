{
  "title": "不肯退潮",
  "title_en": "The Tide Keeps Returning",
  "series": "神話未完成",
  "series_en": "Myths in the Making",
  "volume": 25,
  "model": "史旺姬",
  "creator": "史旺基 Swanky",
  "slug": "swanky-ji-the-tide-keeps-returning",
