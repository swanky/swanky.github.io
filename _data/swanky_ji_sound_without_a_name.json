  "credit_en": "",
  "chapters": [
    {
      "number": 1,
      "title": "空白",
      "title_en": "Blankness",
      "text": "她先備好了葉，卻不知道要留下什麼。",
      "text_en": "She prepares the leaves before knowing what to keep.",
      "frames": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    {
      "number": 2,
      "title": "學習",
      "title_en": "Learning",
      "text": "一根弦把手指的猶豫傳到另一個人的耳邊。",
      "text_en": "One string carries the hesitation of a hand to another person’s ear.",
      "frames": [
        7,
        8,
        9,
        10,
        11,
        12
      ]
    },
    {
      "number": 3,
      "title": "噪音",
      "title_en": "Noise",
      "text": "每一件東西都在發聲。她還不能分開它們。",
      "text_en": "Everything makes a sound. She cannot yet tell them apart.",
      "frames": [
        13,
        14,
        15,
        16,
        17,
        18
      ]
    },
    {
      "number": 4,
      "title": "辨認",
      "title_en": "Recognition",
      "text": "她停下來，開始聽見聲音之間的距離。",
      "text_en": "She stops and begins to hear the distance between sounds.",
      "frames": [
        19,
        20,
        21,
        22,
        23,
        24
      ]
    },
    {
      "number": 5,
      "title": "創作",
      "title_en": "Making",
      "text": "留下的線不再只是記號。她試著讓另一個人聽見。",
      "text_en": "The lines she leaves become more than marks. She tries to make them heard.",
      "frames": [
        25,
        26,
        27,
        28,
        29,
        30
      ]
    },
    {
      "number": 6,
      "title": "被聽見",
      "title_en": "Being Heard",
      "text": "聲音走到她看不見的地方。下一個音仍然沒有名字。",
      "text_en": "The sound travels beyond her sight. The next note still has no name.",
      "frames": [
        31,
        32,
        33,
        34,
        35,
        36
      ]
    }
  ],
