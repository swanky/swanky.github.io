{
  "title": "玉米長成天空",
  "title_en": "How Far Can a Seed See?",
  "series": "神話未完成",
  "series_en": "Myths in the Making",
  "volume": 33,
  "model": "史旺姬",
  "creator": "史旺基 Swanky",
  "slug": "swanky-ji-maize-grows-into-the-sky",
  "date": "2026-11-03",
  "count": 36,
