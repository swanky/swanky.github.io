{"id":"honglou-012-a0001","chapter":12,"order":1,"note":"【蒙：反正從來總一心，鏡光至意兩相尋。有朝敲破蒙頭瓮，綠水青山任好春。】"}
{"id":"honglou-012-a0002","chapter":12,"order":2,"note":"【庚辰側批：立意追命。】"}
{"id":"honglou-012-a0003","chapter":12,"order":3,"note":"【庚辰側批：如蛇。】"}
{"id":"honglou-012-a0004","chapter":12,"order":4,"note":"【蒙側批：旁敲遠引。】"}
{"id":"honglou-012-a0005","chapter":12,"order":5,"note":"【蒙側批：這是鉤。】"}
{"id":"honglou-012-a0006","chapter":12,"order":6,"note":"【庚辰雙行夾批：如聞其聲。】"}
{"id":"honglou-012-a0007","chapter":12,"order":7,"note":"【庚辰雙行夾批：漸漸入港。】"}
{"id":"honglou-012-a0008","chapter":12,"order":8,"note":"【庚辰眉批：勿作正面看為幸。畸笏。蒙側批：游魚雖有入瓮之志，無鉤不能上岸；一上鉤來，欲去亦不可得。】"}
{"id":"honglou-012-a0009","chapter":12,"order":9,"note":"【庚辰雙行夾批：奇妙！】"}
{"id":"honglou-012-a0010","chapter":12,"order":10,"note":"【庚辰側批：這倒不假。】"}
{"id":"honglou-012-a0011","chapter":12,"order":11,"note":"【庚辰側批：反文著眼。】"}
{"id":"honglou-012-a0012","chapter":12,"order":12,"note":"【［寫呆人痴性活現。］】"}
{"id":"honglou-012-a0013","chapter":12,"order":13,"note":"【庚辰雙行夾批：叫去正是叫來也。】"}
{"id":"honglou-012-a0014","chapter":12,"order":14,"note":"【庚辰眉批：先寫穿堂，只知房舍之大，豈料有許多用處。】"}
{"id":"honglou-012-a0015","chapter":12,"order":15,"note":"【蒙側批：凡人在平靜時，物來言至，無不照見。若迷於一事一物，雖風雷交作，有所不聞。即「穿堂爾等」之一語，府第非比凡常，關門戶，必要查看，且更夫僕婦，勢必往來，豈容人藏過於其間？只因色迷，聞聲聯諾，不能有回思之暇，信可悲夫！】"}
{"id":"honglou-012-a0016","chapter":12,"order":16,"note":"【庚辰側批：未必。】"}
{"id":"honglou-012-a0017","chapter":12,"order":17,"note":"【庚辰側批：平平略施小計。】"}
{"id":"honglou-012-a0018","chapter":12,"order":18,"note":"【蒙側批：此大抵是鳳姐調遣。不先為點明者，可以少許多事故，又可以藏拙。】"}
{"id":"honglou-012-a0019","chapter":12,"order":19,"note":"【庚辰眉批：可為偷情一戒。蒙側批：教導之法、慈悲之心盡矣，無奈迷徑不悟何！】"}
{"id":"honglou-012-a0020","chapter":12,"order":20,"note":"【庚辰眉批：教訓最嚴，奈其心何！一嘆。】"}
{"id":"honglou-012-a0021","chapter":12,"order":21,"note":"【庚辰側批：輾轉靈活，一人不放，一筆不肖。】"}
{"id":"honglou-012-a0022","chapter":12,"order":22,"note":"【庚辰側批：世人萬萬想不到，況老學究乎！】"}
{"id":"honglou-012-a0023","chapter":12,"order":23,"note":"【庚辰眉批：處處點父母痴心、子孫不肖。此書系自愧而成。】"}
{"id":"honglou-012-a0024","chapter":12,"order":24,"note":"【［教令何嘗不好，孽種故此不同。］】"}
{"id":"honglou-012-a0025","chapter":12,"order":25,"note":"【庚辰雙行夾批：禍福無門，唯人自招。】"}
{"id":"honglou-012-a0026","chapter":12,"order":26,"note":"【庚辰側批：四字是尋死之根。庚辰眉批：苦海無邊，回頭是岸。若個能回頭也？嘆嘆！壬午春。畸笏。】"}
{"id":"honglou-012-a0027","chapter":12,"order":27,"note":"【庚辰側批：可謂因人而使。】"}
{"id":"honglou-012-a0028","chapter":12,"order":28,"note":"【庚辰側批：四字是作者明阿鳳身份，勿得輕輕看過。】"}
{"id":"honglou-012-a0029","chapter":12,"order":29,"note":"【庚辰雙行夾批：伏得妙！】"}
{"id":"honglou-012-a0030","chapter":12,"order":30,"note":"【庚辰側批：緊一句。】"}
{"id":"honglou-012-a0031","chapter":12,"order":31,"note":"【蒙側批：大士心腸。】"}
{"id":"honglou-012-a0032","chapter":12,"order":32,"note":"【庚辰雙行夾批：不差。】"}
{"id":"honglou-012-a0033","chapter":12,"order":33,"note":"【庚辰側批：未必。】"}
{"id":"honglou-012-a0034","chapter":12,"order":34,"note":"【庚辰側批：四字用得新，必有新文字好看。】"}
{"id":"honglou-012-a0035","chapter":12,"order":35,"note":"【蒙側批：新文，最妙！】"}
{"id":"honglou-012-a0036","chapter":12,"order":36,"note":"【庚辰雙行夾批：專能忙中寫閒，狡猾之甚！】"}
{"id":"honglou-012-a0037","chapter":12,"order":37,"note":"【蒙側批：有心人記著，其實苦惱。】"}
{"id":"honglou-012-a0038","chapter":12,"order":38,"note":"【蒙側批：似醒非醒語。】"}
{"id":"honglou-012-a0039","chapter":12,"order":39,"note":"【庚辰側批：真到了。】"}
{"id":"honglou-012-a0040","chapter":12,"order":40,"note":"【蒙側批：醜態可笑。】"}
{"id":"honglou-012-a0041","chapter":12,"order":41,"note":"【庚辰側批：好極！】"}
{"id":"honglou-012-a0042","chapter":12,"order":42,"note":"【庚辰側批：將到矣。】"}
{"id":"honglou-012-a0043","chapter":12,"order":43,"note":"【庚辰雙行夾批：奇絕！】"}
{"id":"honglou-012-a0044","chapter":12,"order":44,"note":"【庚辰側批：亦未必真。】"}
{"id":"honglou-012-a0045","chapter":12,"order":45,"note":"【庚辰側批：好題目。】"}
{"id":"honglou-012-a0046","chapter":12,"order":46,"note":"【庚辰眉批：調戲還要有故？一笑！】"}
{"id":"honglou-012-a0047","chapter":12,"order":47,"note":"【庚辰側批：好大題目。】"}
{"id":"honglou-012-a0048","chapter":12,"order":48,"note":"【庚辰側批：也知寫不得。一嘆！】"}
{"id":"honglou-012-a0049","chapter":12,"order":49,"note":"【庚辰側批：二字妙！】"}
{"id":"honglou-012-a0050","chapter":12,"order":50,"note":"【蒙側批：可憐至此！好事者當自度。】"}
{"id":"honglou-012-a0051","chapter":12,"order":51,"note":"【蒙側批：此是加一倍法。】"}
{"id":"honglou-012-a0052","chapter":12,"order":52,"note":"【庚辰雙行夾批：又生波瀾。】"}
{"id":"honglou-012-a0053","chapter":12,"order":53,"note":"【庚辰雙行夾批：細。】"}
{"id":"honglou-012-a0054","chapter":12,"order":54,"note":"【庚辰側批：未必如此收場。】"}
{"id":"honglou-012-a0055","chapter":12,"order":55,"note":"【庚辰雙行夾批：更奇。】"}
{"id":"honglou-012-a0056","chapter":12,"order":56,"note":"【庚辰側批：余料必有新奇解恨文字收場，方是《石頭記》筆力。】"}
{"id":"honglou-012-a0057","chapter":12,"order":57,"note":"【庚辰眉批：瑞奴實當如是報之。此一節可入《西廂記》批評內十大快中。畸笏。】"}
{"id":"honglou-012-a0058","chapter":12,"order":58,"note":"【蒙側批：這也未必不是預為埋伏者。總是慈悲設教，遇難教者，不得不現三頭六臂，並吃人心、喝人血之相，以警戒之耳。】"}
{"id":"honglou-012-a0059","chapter":12,"order":59,"note":"【庚辰側批：欲根未斷。】"}
{"id":"honglou-012-a0060","chapter":12,"order":60,"note":"【庚辰眉批：此刻還不回頭，真自尋死路矣。】"}
{"id":"honglou-012-a0061","chapter":12,"order":61,"note":"【蒙側批：孫行者非有緊箍兒，雖老君之爐、五行之山，何嘗屈其一二？】"}
{"id":"honglou-012-a0062","chapter":12,"order":62,"note":"【庚辰雙行夾批：寫得歷歷病源，如何不死？】"}
{"id":"honglou-012-a0063","chapter":12,"order":63,"note":"【庚辰側批：所謂步步緊。】"}
{"id":"honglou-012-a0064","chapter":12,"order":64,"note":"【庚辰側批：簡潔之至！】"}
{"id":"honglou-012-a0065","chapter":12,"order":65,"note":"【庚辰雙行夾批：說得有趣。】"}
{"id":"honglou-012-a0066","chapter":12,"order":66,"note":"【庚辰雙行夾批：王夫人之慈若是。】"}
{"id":"honglou-012-a0067","chapter":12,"order":67,"note":"【庚辰雙行夾批：夾寫王夫人。】"}
{"id":"honglou-012-a0068","chapter":12,"order":68,"note":"【蒙側批：「只說」。】"}
{"id":"honglou-012-a0069","chapter":12,"order":69,"note":"【庚辰雙行夾批：然便有二兩獨參湯，賈瑞固亦不能微好，又豈能望好，但鳳姐之毒何如是？終是瑞之自失也。】"}
{"id":"honglou-012-a0070","chapter":12,"order":70,"note":"【庚辰雙行夾批：自甄士隱隨君一去，別來無恙否？】"}
{"id":"honglou-012-a0071","chapter":12,"order":71,"note":"【庚辰雙行夾批：如聞其聲，吾不忍聽也。】"}
{"id":"honglou-012-a0072","chapter":12,"order":72,"note":"【庚辰雙行夾批：如見其形，吾不忍看也。】"}
{"id":"honglou-012-a0073","chapter":12,"order":73,"note":"【庚辰雙行夾批：人之將死，其言也哀，作者如何下筆？】"}
{"id":"honglou-012-a0074","chapter":12,"order":74,"note":"【庚辰雙行夾批：妙極！此褡褳猶是士隱所搶揹者乎？】"}
{"id":"honglou-012-a0075","chapter":12,"order":75,"note":"【庚辰雙行夾批：凡看書人從此細心體貼，方許你看，否則此書哭矣。】"}
{"id":"honglou-012-a0076","chapter":12,"order":76,"note":"【庚辰雙行夾批：此書表裡皆有喻也。】"}
{"id":"honglou-012-a0077","chapter":12,"order":77,"note":"【庚辰雙行夾批：明點。】"}
{"id":"honglou-012-a0078","chapter":12,"order":78,"note":"【庚辰雙行夾批：言此書原系空虛幻設。】"}
{"id":"honglou-012-a0079","chapter":12,"order":79,"note":"【庚辰眉批：與「紅樓夢」呼應。】"}
{"id":"honglou-012-a0080","chapter":12,"order":80,"note":"【庚辰雙行夾批：畢真。】"}
{"id":"honglou-012-a0081","chapter":12,"order":81,"note":"【庚辰雙行夾批：畢真。】"}
{"id":"honglou-012-a0082","chapter":12,"order":82,"note":"【庚辰雙行夾批：所謂無能紈絝是也。】"}
{"id":"honglou-012-a0083","chapter":12,"order":83,"note":"【庚辰側批：誰人識得此句！】"}
{"id":"honglou-012-a0084","chapter":12,"order":84,"note":"【庚辰雙行夾批：觀者記之，不要看這書正面，方是會看。】"}
{"id":"honglou-012-a0085","chapter":12,"order":85,"note":"【庚辰雙行夾批：記之。】"}
{"id":"honglou-012-a0086","chapter":12,"order":86,"note":"【庚辰雙行夾批：所謂「好知青冢骷髏骨，就是紅樓掩面人」是也。作者好苦心思。】"}
{"id":"honglou-012-a0087","chapter":12,"order":87,"note":"【庚辰側批：可怕是「招手」二字。】"}
{"id":"honglou-012-a0088","chapter":12,"order":88,"note":"【庚辰雙行夾批：奇絕！】"}
{"id":"honglou-012-a0089","chapter":12,"order":89,"note":"【庚辰雙行夾批：寫得奇峭，真好筆墨。】"}
{"id":"honglou-012-a0090","chapter":12,"order":90,"note":"【蒙側批：此一句力如龍象，意謂：正面你方纔已自領略了，你也當思想反面才是。】"}
{"id":"honglou-012-a0091","chapter":12,"order":91,"note":"【庚辰雙行夾批：所謂醉生夢死也。】"}
{"id":"honglou-012-a0092","chapter":12,"order":92,"note":"【庚辰雙行夾批：可憐！大眾齊來看此。】"}
{"id":"honglou-012-a0093","chapter":12,"order":93,"note":"【蒙側批：這是作書者之立意，要寫情種，故於此試一深寫之。在賈瑞則是求仁而得仁，未嘗不含笑九泉，雖死亦不解脫者，悲矣！】"}
{"id":"honglou-012-a0094","chapter":12,"order":94,"note":"【庚辰雙行夾批：此書不免腐儒一謗。】"}
{"id":"honglou-012-a0095","chapter":12,"order":95,"note":"【庚辰雙行夾批：凡野史俱可毀，獨此書不可毀。】"}
{"id":"honglou-012-a0096","chapter":12,"order":96,"note":"【庚辰雙行夾批：腐儒。】"}
{"id":"honglou-012-a0097","chapter":12,"order":97,"note":"【庚辰雙行夾批：觀者記之。】"}
{"id":"honglou-012-a0098","chapter":12,"order":98,"note":"【庚辰雙行夾批：所謂「鐵門限」事業。先安一開路道之人，以備秦氏仙柩有方也。】"}
{"id":"honglou-012-a0099","chapter":12,"order":99,"note":"【蒙側批：須要林黛玉長住，偏要暫離。】"}
{"id":"honglou-012-a0100","chapter":12,"order":100,"note":"【庚辰：此回忽遣黛玉去者，正為下回可兒之文也。若不遣去，只寫可兒、阿鳳等人，卻置黛玉於榮府，成何文哉？故必遣去，方好放筆寫秦，方不脫髮。況黛玉乃書中正人，秦為陪客，豈因陪而失正耶？後大觀園方是寶玉、寶釵、黛玉等正經文字，前皆系陪襯之文也。】"}
{"id":"honglou-012-a0101","chapter":12,"order":101,"note":"【蒙回末總評：儒家正心，道者煉心，釋輩戒心。可見此心無有不到，無不能入者，獨畏其入於邪而不反，故用正煉戒以縛之。請看賈瑞一起念，及至於死，專誠不二，雖經兩次警教，毫無反悔，可謂痴子，可謂愚情。相乃可思，不能相而獨欲思，豈逃傾頹？作者以此作一新樣情理，以助解者生笑，以為痴者設以棒喝耳！】"}
