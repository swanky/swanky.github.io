{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book-character.schema.json",
  "title": "BookCharacters",
  "description": "一本書的角色館資料。對應 _data/book_characters/{book_id}.json（陣列）。由 tools/import_book_characters.mjs 生成；人物介紹為 AI 依原文整理（cast.json），圖像判讀與 alt 來自逐張人工流程判圖。",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/character" },
  "$defs": {
    "character": {
      "type": "object",
      "required": ["slug", "name", "gender", "one_liner", "identity", "image", "width", "height", "alt"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gender": {
          "enum": ["女", "男"]
        },
        "importance": {
          "type": "string"
        },
        "one_liner": {
          "type": "string",
          "description": "cast.json 的 oneLiner，AI 依原文整理；「（推斷）」標記須保留"
        },
        "identity": {
          "type": "string",
          "description": "cast.json 的 persona.identity"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.jpg$",
          "description": "檔名（不含路徑）；實檔在 assets/img/books/{book_id}/characters/"
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": {
          "type": "string",
          "description": "TA 白話一句，判圖流程產出"
        },
        "also_in": {
          "type": "object",
          "description": "跨作品同名人物的互連。**手動維護，不是 tools/import_book_characters.mjs 產生的**——重跑匯入時必須保留這個欄位（tests/cross-book-characters.test.mjs 是掉失的警報）。同名不等於同一人（architecture.md §6：跨作品同名角色不得視為同一人），本欄只提供對照連結，不做版本承襲判斷；一切版本學說法一律逐字引用 _data/books.yml 既有措辭。",
          "required": ["heading", "intro", "url", "link_text", "count_note"],
          "additionalProperties": false,
          "properties": {
            "heading": { "type": "string" },
            "intro": { "type": "string" },
            "url": {
              "type": "string",
              "pattern": "^/[a-z0-9/-]+/$",
              "description": "另一部作品裡同名人物的頁面網址（站內絕對路徑）"
            },
            "link_text": { "type": "string" },
            "count_note": {
              "type": "string",
              "description": "名字在另一部作品出現的回次統計（機械事實），不得寫成情節或戲份判斷"
            }
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["image", "label", "width", "height", "alt"],
            "additionalProperties": false,
            "properties": {
              "image": { "type": "string", "pattern": "^[a-z0-9-]+\\.jpg$" },
              "label": { "type": "string" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "alt": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
