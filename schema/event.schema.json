{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "事件。只記敘事順序（sequence），不推測故事世界日期——古典小說內部時序常自相矛盾，AI 推測必然造假（PLAN.md §28）。原文明寫的時間記在 description 並附 evidence。",
  "type": "object",
  "required": ["id", "book_id", "chapter", "sequence", "title", "paragraphs", "review_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^event-[a-z][a-z0-9-]*-[0-9]{3}-[0-9]{2}$" },
    "book_id": { "type": "string" },
    "chapter": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "characters": { "type": "array", "items": { "type": "string" } },
    "locations": { "type": "array", "items": { "type": "string" } },
    "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9]{3}-p[0-9]{4}$" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generated_by": { "type": "string" },
    "review_status": { "enum": ["unreviewed", "ai-reviewed", "human-reviewed", "verified"] }
  }
}
